{
  "id": "monthly-sales",
  "name": "月度销售",
  "fields": [
    { "name": "month", "label": "月份", "dataType": "string", "role": "dimension" },
    { "name": "region", "label": "区域", "dataType": "string", "role": "dimension" },
    { "name": "category", "label": "品类", "dataType": "string", "role": "dimension" },
    {
      "name": "revenue",
      "label": "销售额",
      "dataType": "number",
      "role": "measure",
      "aggregations": ["sum", "avg", "min", "max"],
      "defaultAggregation": "sum"
    },
    {
      "name": "orders",
      "label": "订单数",
      "dataType": "number",
      "role": "measure",
      "aggregations": ["sum", "avg", "count", "min", "max"],
      "defaultAggregation": "sum"
    },
    {
      "name": "profit",
      "label": "利润",
      "dataType": "number",
      "role": "measure",
      "aggregations": ["sum", "avg", "min", "max"],
      "defaultAggregation": "sum"
    }
  ],
