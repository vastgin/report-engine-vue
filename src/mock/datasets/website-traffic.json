{
  "id": "website-traffic",
  "name": "网站流量",
  "fields": [
    { "name": "date", "label": "日期", "dataType": "string", "role": "dimension" },
    { "name": "channel", "label": "来源渠道", "dataType": "string", "role": "dimension" },
    { "name": "device", "label": "设备", "dataType": "string", "role": "dimension" },
    {
      "name": "visits",
      "label": "访问量",
      "dataType": "number",
      "role": "measure",
      "aggregations": ["sum", "avg", "min", "max"],
      "defaultAggregation": "sum"
    },
    {
      "name": "uniqueVisitors",
      "label": "独立访客",
      "dataType": "number",
      "role": "measure",
      "aggregations": ["sum", "avg", "min", "max"],
      "defaultAggregation": "sum"
    },
    {
      "name": "conversions",
      "label": "转化数",
      "dataType": "number",
      "role": "measure",
      "aggregations": ["sum", "avg", "count", "min", "max"],
      "defaultAggregation": "sum"
    }
  ],
