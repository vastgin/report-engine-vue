{
  "name": "report-design",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Self-built report engine mockup: ECharts + Vue 3 designer and preview",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
